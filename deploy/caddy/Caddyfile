{
    # Global options
    auto_https off
    admin off
    order ja3 before reverse_proxy
}

api.fingertrace.app {
    # TLS configuration
    tls /etc/letsencrypt/live/api.fingertrace.app/fullchain.pem /etc/letsencrypt/live/api.fingertrace.app/privkey.pem

    # Enable JA3 fingerprinting and proxy
    route {
        ja3
        
        # Reverse proxy to Flask backend
        reverse_proxy backend:5000 {
            # Forward JA3 header to backend (backend expects X-JA3)
            header_up X-JA3 {http.request.tls.ja3}
            header_up Host {host}
            header_up X-Real-IP {remote_host}
        }
    }
}

# HTTP redirect
http://api.fingertrace.app {
    redir https://api.fingertrace.app{uri} permanent
}
