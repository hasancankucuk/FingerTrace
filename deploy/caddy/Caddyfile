{
    # Global options
    auto_https off
    admin off
}

api.fingertrace.app {
    # Enable JA3 fingerprinting
    ja3

    # TLS configuration
    tls /etc/letsencrypt/live/api.fingertrace.app/fullchain.pem /etc/letsencrypt/live/api.fingertrace.app/privkey.pem

    # Reverse proxy to Flask backend
    reverse_proxy /api/* backend:5000 {
        # Forward JA3 header to backend
        header_up X-JA3-Fingerprint {http.request.tls.ja3}
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }

    # Return 404 for root
    respond / 404
}

# HTTP redirect
http://api.fingertrace.app {
    redir https://api.fingertrace.app{uri} permanent
}
